{
  "name": "roblox_roguelike",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "KeyboardMouse",
        "DevTouchMovementMode": "Thumbstick",
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 10,
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.27451,
          0.29412,
          0.35294
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
